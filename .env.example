# Copy to .env (never commit .env)
# Vault path: config/settings.json (Status UI) wins over VAULT_PATH when both are set.
# Use VAULT_PATH only for one-off overrides when settings.json has no vaultPath yet.

# LLM Wiki (Obsidian vault root) — required for real ingest
VAULT_PATH=/Users/YOU/Library/Mobile Documents/com~apple~CloudDocs/Obsidian/YourVault

# Job / answer / usage data (outside this repo)
DATA_DIR=/Users/YOU/ai-office-data

# Demo / tests:
# VAULT_PATH=./fixtures/sample-vault
# DATA_DIR=./.ai-office-data

INGEST_BATCH_LIMIT=3

# yt-dlp binary (PATH name or absolute path)
YT_DLP_PATH=yt-dlp

# Claude Code CLI for summarizer/integrator (Pro login; no API key)
CLAUDE_PATH=claude

# aiMode: claude | stub  (stub = no tokens, for offline/dev)
AI_MODE=claude

WEEKLY_INGEST_TOKEN_BUDGET=0
WEEKLY_ASK_TOKEN_BUDGET=0
