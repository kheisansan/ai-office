<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-office.ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>npm</string>
    <string>run</string>
    <string>office</string>
    <string>--</string>
    <string>ingest</string>
    <string>--limit</string>
    <string>3</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/REPLACE/WITH/ai-office</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/ai-office-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ai-office-ingest.err</string>
</dict>
</plist>
