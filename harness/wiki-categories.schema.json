{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiCategories",
  "type": "object",
  "required": ["version", "categories"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
